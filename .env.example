# LLM keys (both optional: without them the brain answers from templates only)
GEMINI_API_KEY=
GROQ_API_KEY=
# Model names change over time. Check the provider docs and update if needed.
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.1-8b-instant

# Telegram (optional until you connect the bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Website origins allowed to call the API (comma separated, no trailing slash)
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://YOUR-SITE.netlify.app

# Optional: where the SQLite file lives
# DB_PATH=data/shelftalk.db
